# =============================================
# Root .dockerignore - for backend build context
# Keep this aggressive: everything not needed at build/runtime
# should be excluded so the build context stays small.
# =============================================

# Build outputs (from all .NET projects)
**/bin
**/obj
**/out
**/publish

# IDE / editor metadata
.vs
.vscode
.idea
.windsurf
**/*.user
**/*.suo

# Git
.git
**/.git
.gitignore
.gitattributes
.github

# Environment files (secrets must never be in image)
.env
.env.*
!.env.example

# Frontend artifacts (it has its own Dockerfile / build context)
frontend/node_modules
frontend/dist
frontend/.vite
frontend/.env
frontend/.env.*
!frontend/.env.example

# Docker files (build context shouldn't include compose / dockerfiles)
docker-compose*.yml
Dockerfile*
.dockerignore

# Logs
**/*.log
logs/

# OS junk
.DS_Store
Thumbs.db

# Documentation
*.md
docs/

# Tests (not shipped with API image)
**/TestResults
**/coverage
WishHub.Tests/

# Local scripts
scripts/dev-tunnel.sh
