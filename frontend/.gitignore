# =============================================
# Frontend .gitignore (React + Vite)
# =============================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
.pnp
.pnp.js

# Build outputs
dist
dist-ssr
*.local

# Environment files - be careful what you commit
# .env files with defaults CAN be committed (contains non-secrets)
# .env.local files contain secrets and MUST NOT be committed
.env.local
.env.*.local
.env.development.local
.env.production.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage/
*.lcov

# Vite
.vite/

# TypeScript
*.tsbuildinfo
