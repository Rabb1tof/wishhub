# =============================================
# Frontend Environment Configuration Template
# =============================================
#
# For local development with Vite dev server
# Production builds use .env from project root
#
# USAGE:
# 1. Copy to .env.local:  cp .env.example .env.local
# 2. Fill in your values
# 3. NEVER commit .env.local to git!
#
# =============================================
# API Configuration
# =============================================

# Backend API URL for local development
# Default: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# SignalR WebSocket URL
# Default: http://localhost:5000/hubs
VITE_HUB_URL=http://localhost:5000/hubs

# =============================================
# For production builds:
# These are set in docker-compose.prod.yml build args
# Or in root .env for EasyPanel deployments
# =============================================
