# =============================================
# WishHub Environment Configuration Template
# =============================================
#
# USAGE:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in ALL values below
# 3. NEVER commit .env to git!
#
# For EasyPanel: paste these variables in the Environment section
#
# =============================================
# REQUIRED: Application URL
# =============================================
# Change for your domain (EasyPanel auto-generates SSL)
PUBLIC_URL=https://your_domain.com

# =============================================
# REQUIRED: Database
# =============================================
POSTGRES_DB=wishlist
POSTGRES_USER=wishlist
# Generate strong password: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# =============================================
# REQUIRED: JWT Secret
# =============================================
# Generate: openssl rand -hex 32
# IMPORTANT: Must be at least 32 characters!
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_SECRET
JWT_ISSUER=WishHub
JWT_AUDIENCE=WishHubUsers

# =============================================
# REQUIRED: OAuth VK ID
# =============================================
# Get from: https://id.vk.ru/business/go
# Redirect URI must be: ${PUBLIC_URL}/api/auth/vk/callback
VK_CLIENT_ID=YOUR_VK_APP_ID
VK_CLIENT_SECRET=YOUR_VK_SECRET

# =============================================
# REQUIRED: Telegram Bot
# =============================================
# Get from @BotFather, set domain via /setdomain
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_BOT_USERNAME=your_bot_username

# =============================================
# OPTIONAL: Background Jobs
# =============================================
HANGFIRE_INTERVAL=8
