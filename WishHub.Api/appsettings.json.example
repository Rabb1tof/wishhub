{
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=wishlist;Username=wishlist;Password=wishlist",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_32+_CHAR_RANDOM_SECRET_KEY_HERE",
    "Issuer": "WishHub",
    "Audience": "WishHubUsers"
  },
  "Frontend": {
    "Url": "http://localhost:5173"
  },
  "OAuth": {
    "Vk": {
      "ClientId": "YOUR_VK_APP_ID",
      "ClientSecret": "YOUR_VK_SECRET_KEY",
      "RedirectUri": "http://localhost:5000/api/auth/vk/callback"
    },
    "Telegram": {
      "BotToken": "YOUR_BOT_TOKEN",
      "BotUsername": "your_bot_username"
    }
  },
  "Hangfire": {
    "PriceUpdateIntervalHours": 8
  },
  "ImageProxy": {
    "AllowedDomains": [
      "images.wbstatic.net",
      "basket-01.wb.ru",
      "basket-02.wb.ru",
      "basket-03.wb.ru",
      "basket-04.wb.ru",
      "basket-05.wb.ru",
      "basket-06.wb.ru",
      "basket-07.wb.ru",
      "basket-08.wb.ru",
